{
  "version": 2,
  "name": "discipulado-app",
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/portal",
      "dest": "/portal.html"
    },
    {
      "src": "/cadastro",
      "dest": "/cadastro.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
